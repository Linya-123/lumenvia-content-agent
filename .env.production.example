# EdgeOne Makers 生产环境变量
# ------------------------------------------------------------
# 用法：EdgeOne 控制台 → 项目 → Environment Variables 逐条填写
# 注意：官方限制「变量值长度 1000 bytes」，不要塞多行内容
# 全部写完后触发一次重新部署才会生效

# ---------- 鉴权（必须设置，否则全站零鉴权）----------
# 设置后浏览器会弹原生登录框；两者任一留空则鉴权自动关闭
AUTH_USER=reviewer
AUTH_PASSWORD=请改成你自己的强密码

# ---------- LLM ----------
# false = 走确定性 stub，不调用模型、不消耗额度、断网也能演示
# true  = 真实调用硅基流动，需要下面填 API key
# 建议：公开演示用 false，现场需要展示真实生成时再临时改 true
LLM_ENABLED=false

LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=
LLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
EMBED_MODEL=BAAI/bge-m3

# 单次请求超时（毫秒）
# 注意：EdgeOne Cloud Functions 单次执行上限 120 秒，
# 这里不要设置得比 120000 更大，否则会被平台强制终止
LLM_TIMEOUT_MS=60000

# ---------- 虚拟品牌 ----------
BRAND_NAME=Lumenvia
BRAND_DOMAIN=lumenvia.com
BRAND_DEMO_EMAIL=demo@lumenvia.com
BRAND_SKU=LMN-LGS-20
BRAND_MODEL=LumenGuard S20

# ---------- 数据库（当前版本不使用，留空即可）----------
# 代码目前是内存存储，不会读取这个变量
# 未来接 Supabase 时再填，EdgeOne 上需走 HTTP 连接而非 TCP
DATABASE_URL=