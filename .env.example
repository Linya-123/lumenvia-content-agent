# ---------- Supabase 数据库 ----------
# 获取位置：Supabase 控制台 → Project Settings → Database → Connection string
# 推荐用 "Connection pooling" 的 Session mode，末尾加 ?sslmode=require
# 形如：
# DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# ---------- LLM（可选） ----------
# 关闭时走确定性 stub，链路照样跑通，评审无需外部额度
# 默认对接硅基流动 SiliconFlow：https://cloud.siliconflow.cn/account/ak 取 key
LLM_ENABLED=false
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=
LLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
EMBED_MODEL=BAAI/bge-m3
# 单次请求超时（毫秒），防止挂死拖住 SSE
LLM_TIMEOUT_MS=60000

# ---------- 虚拟品牌（唯一允许出现品牌信息的位置） ----------
BRAND_NAME=Lumenvia
BRAND_DOMAIN=lumenvia.com
BRAND_DEMO_EMAIL=demo@lumenvia.com
BRAND_SKU=LMN-LGS-20
BRAND_MODEL=LumenGuard S20

# ---------- 评审鉴权（可选） ----------
# 两者都设置时启用登录页 + Cookie 会话；任一留空则关闭（本地开发零摩擦）
# 部署时务必设置，防止公网任意访问消耗 LLM 额度
# 真实密码只写进 .env.local 或平台环境变量，不要提交到仓库
AUTH_USER=
AUTH_PASSWORD=

# 免登录天数（不填默认 30，上限 365）
SESSION_DAYS=30
# 会话签名密钥；不填则自动由账号密码派生。
# 想在不改密码的前提下让所有设备重新登录，就换一个随机值：openssl rand -hex 32
AUTH_SECRET=
